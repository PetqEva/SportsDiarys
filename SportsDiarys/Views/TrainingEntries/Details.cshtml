@using SportsDiarys.ViewModels.TrainingEntries
@model TrainingEntryDetailsPageVm

@{
    ViewData["Title"] = "Детайли за запис";
    var entry = Model.Entry;
    var backUrl = !string.IsNullOrWhiteSpace(Model.ReturnUrl)
        ? Model.ReturnUrl
        : Url.Action("Index", "TrainingEntries");
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="mb-0">@ViewData["Title"]</h1>

    <div class="d-flex gap-2">
        <a class="btn btn-primary"
               asp-action="Edit"
               asp-route-id="@entry.Id"
               asp-route-returnUrl="@Model.ReturnUrl">
            Редакция
        </a>

        <a class="btn btn-outline-danger"
               asp-action="Delete"
               asp-route-id="@entry.Id"
               asp-route-returnUrl="@Model.ReturnUrl">
            Изтрий
        </a>

        <a class="btn btn-secondary" href="@backUrl">
            Назад
        </a>
    </div>
</div>

<div class="card shadow-sm mb-4">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">Спорт</dt>
            <dd class="col-sm-9">@entry.SportName</dd>

            <dt class="col-sm-3">Продължителност</dt>
            <dd class="col-sm-9">@entry.DurationMinutes мин.</dd>

            <dt class="col-sm-3">Калории</dt>
            <dd class="col-sm-9">@entry.Calories kcal</dd>

            <dt class="col-sm-3">Дистанция</dt>
            <dd class="col-sm-9">
                @(entry.DistanceKm.HasValue ? $"{entry.DistanceKm.Value:0.##} km" : "-")
            </dd>

            <dt class="col-sm-3">Дневник</dt>
            <dd class="col-sm-9">
                @if (!string.IsNullOrWhiteSpace(entry.DiaryLabel))
                {
                    <span>@entry.DiaryLabel</span>
                    <span class="text-muted">(ID: @entry.TrainingDiaryId)</span>
                }
                else
                {
                    <span>#@entry.TrainingDiaryId</span>
                }
            </dd>

            @if (entry.DiaryDate != default)
            {
                <dt class="col-sm-3">Дата</dt>
                <dd class="col-sm-9">@entry.DiaryDate.ToString("dd.MM.yyyy")</dd>
            }

            @if (!string.IsNullOrWhiteSpace(entry.UserName))
            {
                <dt class="col-sm-3">Потребител</dt>
                <dd class="col-sm-9">@entry.UserName</dd>
            }
        </dl>
    </div>
</div>

<div class="card shadow-sm mb-4">
    <div class="card-body">
        <h4 class="mb-3">Упражнения</h4>

        @if (Model.Exercises == null || !Model.Exercises.Any())
        {
            <div class="alert alert-light border mb-0">
                Няма добавени упражнения.
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Упражнение</th>
                            <th class="text-center">Серии</th>
                            <th class="text-center">Повторения</th>
                            <th class="text-center">Тежест (кг)</th>
                            <th class="text-center">Време (сек)</th>
                            <th class="text-end">Действия</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var exercise in Model.Exercises)
                        {
                            <tr>
                                <td>@exercise.Name</td>
                                <td class="text-center">@exercise.Sets</td>
                                <td class="text-center">@exercise.Reps</td>
                                <td class="text-center">
                                    @(exercise.WeightKg.HasValue? exercise.WeightKg.Value.ToString("0.##") : "-")
                                </td>
                                <td class="text-center">
                                    @(exercise.DurationSeconds.HasValue? exercise.DurationSeconds.Value.ToString() : "-")
                                </td>
                                <td class="text-end">
                                    <form asp-action="RemoveExercise" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="trainingEntryId" value="@entry.Id" />
                                        <input type="hidden" name="exerciseId" value="@exercise.ExerciseId" />
                                        <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger">
                                            Махни
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <h4 class="mb-3">Добави упражнение</h4>

        <form asp-action="AddExercise" method="post">
            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <input type="hidden" asp-for="AddExercise.TrainingEntryId" />
            <input type="hidden" asp-for="ReturnUrl" />

            <div class="row g-3">
                <div class="col-md-4">
                    <label asp-for="AddExercise.ExerciseId" class="form-label">Упражнение</label>
                    <select asp-for="AddExercise.ExerciseId"
                            asp-items="Model.AddExercise.AvailableExercises"
                            class="form-select">
                        <option value="">-- избери упражнение --</option>
                    </select>
                    <span asp-validation-for="AddExercise.ExerciseId" class="text-danger"></span>
                </div>

                <div class="col-md-2">
                    <label asp-for="AddExercise.Sets" class="form-label">Серии</label>
                    <input asp-for="AddExercise.Sets" class="form-control" />
                    <span asp-validation-for="AddExercise.Sets" class="text-danger"></span>
                </div>

                <div class="col-md-2">
                    <label asp-for="AddExercise.Reps" class="form-label">Повторения</label>
                    <input asp-for="AddExercise.Reps" class="form-control" />
                    <span asp-validation-for="AddExercise.Reps" class="text-danger"></span>
                </div>

                <div class="col-md-2">
                    <label asp-for="AddExercise.WeightKg" class="form-label">Тежест (кг)</label>
                    <input asp-for="AddExercise.WeightKg" class="form-control" />
                    <span asp-validation-for="AddExercise.WeightKg" class="text-danger"></span>
                </div>

                <div class="col-md-2">
                    <label asp-for="AddExercise.DurationSeconds" class="form-label">Време (сек)</label>
                    <input asp-for="AddExercise.DurationSeconds" class="form-control" />
                    <span asp-validation-for="AddExercise.DurationSeconds" class="text-danger"></span>
                </div>
            </div>

            <div class="mt-3">
                <button type="submit" class="btn btn-success">
                    Добави упражнение
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}