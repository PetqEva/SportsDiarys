@using SportsDiarys.ViewModels.Exercises
@model ExerciseListVm

@{
    ViewData["Title"] = "Упражнения";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>@ViewData["Title"]</h1>
    <a class="btn btn-primary" asp-action="Create">+ Ново упражнение</a>
</div>

<form method="get" class="mb-3">
    <div class="row g-2">
        <div class="col-auto">
            <input class="form-control" name="SearchTerm" placeholder="Търси упражнение..." value="@Model.Query.Search" />
        </div>
        <div class="col-auto">
            <select class="form-select" name="PageSize">
                @foreach (var size in new[] { 5, 10, 20, 50 })
                {
                    <option value="@size" selected="@(Model.Query.PageSize == size ? "selected" : null)">@size</option>
                }
            </select>
        </div>
        <div class="col-auto">
            <button class="btn btn-outline-primary" type="submit">Филтрирай</button>
        </div>
    </div>
</form>

<table class="table table-striped table-hover align-middle">
    <thead>
        <tr>
            <th>Име</th>
            <th>Активен</th>
            <th class="text-end">Действия</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Items)
        {
            <tr>
                <td>@item.Name</td>
                <td>@(item.IsActive ? "Да" : "Не")</td>
                <td class="text-end text-nowrap">
                    <a class="btn btn-sm btn-primary" asp-action="Edit" asp-route-id="@item.Id">Редакция</a>

                    <form method="post" asp-action="SetActive" class="d-inline">
                        <input type="hidden" name="id" value="@item.Id" />
                        <input type="hidden" name="isActive" value="@(item.IsActive ? "false" : "true")" />
                        <button type="submit" class="btn btn-sm @(item.IsActive ? "btn-warning" : "btn-success")">
                            @(item.IsActive ? "Деактивирай" : "Активирай")
                        </button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>

<nav>
    <ul class="pagination">
        <li class="page-item @(Model.Query.Page == 1 ? "disabled" : "")">
            <a class="page-link" asp-action="Index" asp-route-Page="@(Model.Query.Page - 1)">Предишна</a>
        </li>

        @for (int p = 1; p <= Model.TotalPages; p++)
        {
            <li class="page-item @(p == Model.Query.Page ? "active" : "")">
                <a class="page-link" asp-action="Index" asp-route-Page="@p">@p</a>
            </li>
        }

        <li class="page-item @(Model.Query.Page == Model.TotalPages ? "disabled" : "")">
            <a class="page-link" asp-action="Index" asp-route-Page="@(Model.Query.Page + 1)">Следваща</a>
        </li>
    </ul>
</nav>