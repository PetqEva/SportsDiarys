@using SportsDiarys.ViewModels.Exercises
@model ExerciseFormVm
@{
    ViewData["Title"] = Model.Id == 0 ? "Новo упражнение" : "Редакция";
}

<h1>@ViewData["Title"]</h1>

<form asp-action="@ViewData["Title"] == " Новo упражнение" ? "Create" : "Edit" " method="post">
    <div class="mb-3">
        <label class="form-label">Име</label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <div class="form-check mb-3">
        <input asp-for="IsActive" class="form-check-input" />
        <label class="form-check-label">Активен</label>
    </div>

    <button type="submit" class="btn btn-primary">Запази</button>
    <a asp-action="Index" class="btn btn-secondary">Отказ</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}