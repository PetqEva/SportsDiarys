@model SportsDiarys.ViewModels.TrainingDiaries.TrainingDiaryDetailsViewModel

@{
    ViewData["Title"] = "Детайли за дневник";

    string dash(string? s) => string.IsNullOrWhiteSpace(s) ? "-" : s;

    string placeText(string? p) => p switch
    {
        "Home" => "В къщи",
        "Gym" => "Фитнес",
        "Outdoor" => "Навън",
        "Other" => "Друго",
        _ => dash(p)
    };

    string placeBadge(string? p) => p switch
    {
        "Gym" => "bg-success",
        "Outdoor" => "bg-primary",
        "Home" => "bg-secondary",
        _ => "bg-warning text-dark"
    };
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <h1 class="mb-1">@ViewData["Title"]</h1>
        <p class="text-muted mb-0">Преглед на избрания тренировъчен дневник.</p>
    </div>

    <div class="d-flex flex-wrap gap-2">
        <a class="btn btn-outline-secondary" asp-action="Index">Назад</a>
        <a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.Id">Редакция</a>
        <a class="btn btn-outline-danger" asp-action="Delete" asp-route-id="@Model.Id">Изтриване</a>
        <a class="btn btn-success"
               asp-controller="TrainingEntries"
               asp-action="Create"
               asp-route-diaryId="@Model.Id">
            + Нов запис
        </a>
    </div>
</div>

<div class="card shadow-sm mb-4">
    <div class="card-body">
        <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-3">
            <div>
                <h3 class="mb-1 fw-bold text-primary">@Model.Date.ToString("dd.MM.yyyy")</h3>
                <span class="badge @placeBadge(Model.Place)">
                    @placeText(Model.Place)
                </span>
            </div>

            <div class="text-muted small">
                Дневник №@Model.Id
            </div>
        </div>

        <div class="row g-3">
            <div class="col-md-4">
                <div class="border rounded-3 p-3 text-center h-100">
                    <div class="text-muted small">Продължителност</div>
                    <div class="fw-bold fs-5">
                        <i class="bi bi-clock"></i> @Model.TotalDurationMinutes мин
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="border rounded-3 p-3 text-center h-100">
                    <div class="text-muted small">Калории</div>
                    <div class="fw-bold fs-5">
                        <i class="bi bi-fire"></i> @Model.TotalCalories
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="border rounded-3 p-3 text-center h-100">
                    <div class="text-muted small">Дистанция</div>
                    <div class="fw-bold fs-5">
                        <i class="bi bi-sign-turn-right"></i> @($"{Model.TotalDistanceKm:0.##} км")
                    </div>
                </div>
            </div>
        </div>

        <hr />

        <div>
            <div class="text-muted small mb-1">Бележки</div>
            <div>@dash(Model.Notes)</div>
        </div>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h4 class="mb-0">Записи в дневника</h4>
            <span class="badge bg-dark">@Model.TotalEntries запис(а)</span>
        </div>

        @if (Model.Entries == null || !Model.Entries.Any())
        {
            <div class="text-center py-4">
                <p class="text-muted mb-3">Все още няма добавени записи към този дневник.</p>
                <a class="btn btn-success"
                       asp-controller="TrainingEntries"
                       asp-action="Create"
                       asp-route-diaryId="@Model.Id">
                    + Добави първи запис
                </a>
            </div>
        }
        else
        {
            <div class="row g-3">
                @foreach (var entry in Model.Entries)
                {
                    <div class="col-md-6 col-xl-4">
                        <div class="border rounded-3 p-3 h-100">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <h5 class="mb-0">@entry.SportName</h5>
                                <span class="badge bg-light text-dark border">#@entry.Id</span>
                            </div>

                            <div class="small text-muted mb-3">
                                Данни за тренировъчния запис
                            </div>

                            <div class="row g-2 mb-3">
                                <div class="col-6">
                                    <div class="border rounded-3 p-2 text-center">
                                        <div class="text-muted small">Минути</div>
                                        <div class="fw-semibold">@entry.DurationMinutes</div>
                                    </div>
                                </div>

                                <div class="col-6">
                                    <div class="border rounded-3 p-2 text-center">
                                        <div class="text-muted small">Калории</div>
                                        <div class="fw-semibold">@entry.Calories</div>
                                    </div>
                                </div>
                            </div>

                            <div class="mb-3">
                                <div class="text-muted small">Дистанция</div>
                                <div class="fw-semibold">
                                    @($"{entry.DistanceKm:0.##} км")
                                </div>
                            </div>

                            <div class="d-flex flex-wrap gap-2">
                                <a class="btn btn-sm btn-outline-secondary"
                                       asp-controller="TrainingEntries"
                                       asp-action="Details"
                                       asp-route-id="@entry.Id">
                                    Детайли
                                </a>

                                <a class="btn btn-sm btn-primary"
                                       asp-controller="TrainingEntries"
                                       asp-action="Edit"
                                       asp-route-id="@entry.Id">
                                    Редакция
                                </a>

                                <a class="btn btn-sm btn-danger"
                                       asp-controller="TrainingEntries"
                                       asp-action="Delete"
                                       asp-route-id="@entry.Id">
                                    Изтриване
                                </a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>