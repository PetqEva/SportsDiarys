@model SportsDiarys.ViewModels.TrainingDiaries.TrainingDiaryListVm

@{
    ViewData["Title"] = "Дневници";

    string dash(string? s) => string.IsNullOrWhiteSpace(s) ? "-" : s;

    string placeText(string? p) => p switch
    {
        "Home" => "В къщи",
        "Gym" => "Фитнес",
        "Outdoor" => "Навън",
        "Other" => "Друго",
        _ => dash(p)
    };

    string placeBadge(string? p) => p switch
    {
        "Gym" => "bg-success",
        "Outdoor" => "bg-primary",
        "Home" => "bg-secondary",
        _ => "bg-warning text-dark"
    };

    var totalPages = (int)Math.Ceiling((double)Model.TotalCount / Model.PageSize);
    var currentSearch = Context.Request.Query["search"].ToString();
    var hasSearch = !string.IsNullOrWhiteSpace(currentSearch);
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-3">
    <div>
        <h1 class="mb-0">@ViewData["Title"]</h1>
        <p class="text-muted mb-0">Преглеждай и управлявай дневниците си по дати.</p>
    </div>

    <div class="d-flex gap-2 align-items-center flex-wrap">
        <form method="get" class="d-flex">
            <input type="hidden" name="page" value="1" />
            <input type="text"
                   name="search"
                   value="@currentSearch"
                   class="form-control me-2"
                   placeholder="Търси по бележки или място..." />
            <button class="btn btn-outline-secondary" type="submit">Търси</button>
        </form>

        <a class="btn btn-primary" asp-action="Create">+ Нов дневник</a>
    </div>
</div>

@if (Model.Items == null || !Model.Items.Any())
{
    <div class="card shadow-sm border-0">
        <div class="card-body text-center py-5">
            @if (hasSearch)
            {
                <h4 class="mb-2">Няма намерени резултати</h4>
                <p class="text-muted mb-3">
                    Няма дневници, които отговарят на търсенето ти.
                </p>
                <a class="btn btn-outline-secondary" asp-action="Index">Изчисти търсенето</a>
            }
            else
            {
                <h4 class="mb-2">Нямаш създадени дневници</h4>
                <p class="text-muted mb-3">
                    Натисни <strong>„Нов дневник“</strong>, за да добавиш първия.
                </p>
                <a class="btn btn-primary" asp-action="Create">+ Нов дневник</a>
            }
        </div>
    </div>
}
else
{
    <div class="row g-4">
        @foreach (var item in Model.Items.OrderByDescending(x => x.Date))
        {
            <div class="col-md-6 col-xl-4">
                <div class="card shadow-sm h-100 border-0">
                    <div class="card-body d-flex flex-column">
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <div>
                                <h5 class="card-title mb-1 fw-bold text-primary">
                                    @item.Date.ToString("dd.MM.yyyy")
                                </h5>
                                <span class="badge @placeBadge(item.Place)">
                                    @placeText(item.Place)
                                </span>
                            </div>
                        </div>

                        <div class="row g-2 mb-3">
                            <div class="col-6">
                                <div class="border rounded-3 p-2 text-center">
                                    <div class="text-muted small">Продължителност</div>
                                    <div class="fw-semibold">
                                        <i class="bi bi-clock"></i> @item.DurationMinutes мин
                                    </div>
                                </div>
                            </div>

                            <div class="col-6">
                                <div class="border rounded-3 p-2 text-center">
                                    <div class="text-muted small">Вода</div>
                                    <div class="fw-semibold">
                                        <i class="bi bi-droplet"></i> @($"{item.WaterLiters:0.##} л")
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="mb-3">
                            <div class="text-muted small mb-1">Бележки</div>
                            <div class="text-muted text-truncate" style="max-width: 220px;">
                                @dash(item.Notes)
                            </div>
                        </div>

                        <div class="mt-auto d-flex justify-content-between flex-wrap gap-2">
                            <a class="btn btn-sm btn-outline-secondary"
                                   asp-action="Details"
                                   asp-route-id="@item.Id">
                                Детайли
                            </a>

                            <a class="btn btn-sm btn-primary"
                                   asp-action="Edit"
                                   asp-route-id="@item.Id">
                                Редакция
                            </a>

                            <a class="btn btn-sm btn-danger"
                                   asp-action="Delete"
                                   asp-route-id="@item.Id">
                                Изтриване
                            </a>

                            <a class="btn btn-sm btn-success"
                                   asp-controller="TrainingEntries"
                                   asp-action="Create"
                                   asp-route-diaryId="@item.Id">
                                + Запис
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    @if (totalPages > 1)
    {
        <nav class="mt-4" aria-label="Навигация по страници">
            <ul class="pagination justify-content-center">
                <li class="page-item @(Model.Page <= 1 ? "disabled" : "")">
                    <a class="page-link"
                           asp-action="Index"
                           asp-route-page="@(Model.Page - 1)"
                           asp-route-search="@currentSearch">
                        Назад
                    </a>
                </li>

                @for (int i = 1; i <= totalPages; i++)
                {
                    <li class="page-item @(i == Model.Page ? "active" : "")">
                        <a class="page-link"
                               asp-action="Index"
                               asp-route-page="@i"
                               asp-route-search="@currentSearch">
                            @i
                        </a>
                    </li>
                }

                <li class="page-item @(Model.Page >= totalPages ? "disabled" : "")">
                    <a class="page-link"
                           asp-action="Index"
                           asp-route-page="@(Model.Page + 1)"
                           asp-route-search="@currentSearch">
                        Напред
                    </a>
                </li>
            </ul>
        </nav>
    }
}