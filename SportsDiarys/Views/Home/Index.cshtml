@model SportsDiarys.ViewModels.Home.HomeDashboardVm

@{
    ViewData["Title"] = "Начало";
}

<div class="text-center mb-4">
    <h1 class="display-5 fw-bold">SportsDiarys</h1>
    <p class="lead">Следи тренировките си, прогреса си и личните си цели.</p>
</div>

@if (!Model.IsAuthenticated)
{
    <div class="card shadow-sm border-0">
        <div class="card-body text-center p-5">
            <h2 class="h4 mb-3">Добре дошъл</h2>
            <p class="text-muted mb-4">
                Влез в профила си, за да видиш дневниците, тренировките и статистиката си.
            </p>

            <a asp-area="Identity" asp-page="/Account/Login" class="btn btn-primary me-2">Вход</a>
            <a asp-area="Identity" asp-page="/Account/Register" class="btn btn-outline-primary">Регистрация</a>
        </div>
    </div>
}
else
{
    <div class="row g-4 mb-4">
        <div class="col-md-6">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body text-center">
                    <h3 class="h6 text-muted">Дневници</h3>
                    <div class="display-6 fw-bold">@Model.DiariesCount</div>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body text-center">
                    <h3 class="h6 text-muted">Тренировки</h3>
                    <div class="display-6 fw-bold">@Model.EntriesCount</div>
                </div>
            </div>
        </div>
    </div>

    <div class="d-flex flex-wrap gap-2">
        <a asp-controller="TrainingDiaries" asp-action="Index" class="btn btn-primary">Моите дневници</a>
        <a asp-controller="TrainingEntries" asp-action="Index" class="btn btn-outline-primary">Моите тренировки</a>

        @if (User.IsInRole("Administrator"))
        {
            <a asp-area="Admin" asp-controller="Exercises" asp-action="Index" class="btn btn-outline-secondary">Упражнения</a>
        }

        <a asp-controller="Calculators" asp-action="Tdee" class="btn btn-outline-dark">TDEE калкулатор</a>
    </div>
}