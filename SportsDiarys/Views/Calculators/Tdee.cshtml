@model SportsDiarys.ViewModels.Calculators.TdeeInputVm
@using SportsDiarys.ViewModels.Calculators

@{
    ViewData["Title"] = "TDEE калкулатор";
    var result = ViewBag.Result as TdeeResultVm;

    string bmiLabel(double bmi) =>
        bmi < 18.5 ? "Поднормено" :
        bmi < 25 ? "Нормално" :
        bmi < 30 ? "Наднормено" : "Затлъстяване";

    string bmiBadge(double bmi) =>
        bmi < 18.5 ? "bg-warning text-dark" :
        bmi < 25 ? "bg-success" :
        bmi < 30 ? "bg-warning text-dark" : "bg-danger";
}

<div class="container mt-4">
    <h1>@ViewData["Title"]</h1>

    @* ✔ Success / Error messages *@
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">
            @TempData["ErrorMessage"]
        </div>
    }

    <hr />

    <div class="row g-4">
        <div class="col-lg-6">
            <form asp-action="Tdee" method="post" class="card shadow-sm">
                @Html.AntiForgeryToken()

                <div class="card-body">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    <div class="mb-3">
                        <label class="form-label">Пол</label>
                        <select asp-for="Gender" class="form-select"
                                asp-items="Html.GetEnumSelectList<Gender>()"></select>
                        <span asp-validation-for="Gender" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Age" class="form-label">Възраст (години)</label>
                        <input asp-for="Age" class="form-control" />
                        <span asp-validation-for="Age" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="WeightKg" class="form-label">Тегло (кг)</label>
                        <input asp-for="WeightKg" class="form-control" />
                        <span asp-validation-for="WeightKg" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="HeightCm" class="form-label">Ръст (см)</label>
                        <input asp-for="HeightCm" class="form-control" />
                        <span asp-validation-for="HeightCm" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="ActivityMultiplier" class="form-label">Ниво на активност</label>
                        <select asp-for="ActivityMultiplier" class="form-select">
                            <option value="1.2">Заседнал — 1.2</option>
                            <option value="1.375">Лека — 1.375</option>
                            <option value="1.55">Умерена — 1.55</option>
                            <option value="1.725">Висока — 1.725</option>
                            <option value="1.9">Много висока — 1.9</option>
                        </select>
                        <span asp-validation-for="ActivityMultiplier" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="BodyFatPercent" class="form-label">Процент мазнини (по желание)</label>
                        <input asp-for="BodyFatPercent" class="form-control" />
                        <span asp-validation-for="BodyFatPercent" class="text-danger"></span>
                        <div class="form-text">
                            Ако го попълниш, използваме Katch–McArdle.
                        </div>
                    </div>

                    <button class="btn btn-primary w-100" type="submit">
                        Изчисли
                    </button>
                </div>
            </form>
        </div>

        <div class="col-lg-6">
            @if (result != null)
            {
                <div class="card shadow-sm">
                    <div class="card-body">
                        <h4>Резултат</h4>
                        <p class="text-muted">Метод: <strong>@result.Method</strong></p>

                        <ul class="list-group mt-3">
                            <li class="list-group-item d-flex justify-content-between">
                                <span>BMR</span>
                                <strong>@result.Bmr kcal</strong>
                            </li>

                            <li class="list-group-item d-flex justify-content-between bg-light">
                                <span class="fw-semibold">TDEE</span>
                                <strong class="text-primary">@result.Tdee kcal</strong>
                            </li>

                            <li class="list-group-item d-flex justify-content-between">
                                <span>Cut -15%</span>
                                <strong class="text-danger">@result.Cut15 kcal</strong>
                            </li>

                            <li class="list-group-item d-flex justify-content-between">
                                <span>Cut -20%</span>
                                <strong class="text-danger">@result.Cut20 kcal</strong>
                            </li>

                            <li class="list-group-item d-flex justify-content-between">
                                <span>Bulk +10%</span>
                                <strong class="text-success">@result.Bulk10 kcal</strong>
                            </li>

                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                <span>BMI</span>
                                <span>
                                    <strong>@result.Bmi</strong>
                                    <span class="badge @bmiBadge(result.Bmi)">
                                        @bmiLabel(result.Bmi)
                                    </span>
                                </span>
                            </li>

                            @if (result.LeanBodyMassKg.HasValue)
                            {
                                <li class="list-group-item d-flex justify-content-between">
                                    <span>LBM</span>
                                    <strong>@result.LeanBodyMassKg.Value кг</strong>
                                </li>
                            }

                            <li class="list-group-item d-flex justify-content-between">
                                <span>Protein</span>
                                <strong>@result.ProteinTargetG г</strong>
                            </li>
                        </ul>

                        <form asp-controller="NutritionTargets" asp-action="Save" method="post" class="mt-3">
                            @Html.AntiForgeryToken()

                            @* ✔ ВАЖНО: имената трябва да съвпадат *@
                            <input type="hidden" name="calories" value="@result.Tdee" />
                            <input type="hidden" name="proteinGrams" value="@result.ProteinTargetG" />

                            <button type="submit" class="btn btn-outline-primary w-100">
                                Запази като дневна цел
                            </button>
                        </form>
                    </div>
                </div>
            }
            else
            {
                <div class="alert alert-secondary">
                    Попълни данните и натисни „Изчисли“.
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}