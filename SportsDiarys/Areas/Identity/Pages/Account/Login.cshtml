@page
@model LoginModel

@{
    ViewData["Title"] = "Вход";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-5 col-md-7">
            <div class="card shadow border-0 rounded-4">
                <div class="card-body p-4 p-md-5">
                    <div class="text-center mb-4">
                        <h1 class="h2 fw-bold mb-2">Вход</h1>
                        <p class="text-muted mb-0">Влез в профила си в SportsDiarys</p>
                    </div>

                    <form id="account" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger small mb-3" role="alert"></div>

                        <div class="form-floating mb-3">
                            <input asp-for="Input.Email" class="form-control rounded-3" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                            <label asp-for="Input.Email">Имейл</label>
                            <span asp-validation-for="Input.Email" class="text-danger small"></span>
                        </div>

                        <div class="form-floating mb-3">
                            <input asp-for="Input.Password" class="form-control rounded-3" autocomplete="current-password" aria-required="true" placeholder="Парола" />
                            <label asp-for="Input.Password">Парола</label>
                            <span asp-validation-for="Input.Password" class="text-danger small"></span>
                        </div>

                        <div class="form-check mb-4">
                            <input class="form-check-input" asp-for="Input.RememberMe" />
                            <label class="form-check-label" asp-for="Input.RememberMe">
                                Запомни ме
                            </label>
                        </div>

                        <button id="login-submit" type="submit" class="btn btn-primary w-100 py-2 rounded-3 fw-semibold">
                            Вход
                        </button>

                        <div class="mt-4 text-center">
                            <p class="mb-2">
                                <a id="forgot-password" asp-page="./ForgotPassword">Забравена парола?</a>
                            </p>
                            <p class="mb-2">
                                Нямаш профил?
                                <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl">Регистрация</a>
                            </p>
                            <p class="mb-0">
                                <a id="resend-confirmation" asp-page="./ResendEmailConfirmation">Изпрати потвърждение отново</a>
                            </p>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}