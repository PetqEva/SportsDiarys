@model IEnumerable<SportsDiarys.ViewModels.TrainingDiaries.TrainingDiaryFormVm>

<h1>Admin: Дневници</h1>
<a class="btn btn-primary mb-3" asp-action="Create">+ Нов дневник</a>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Дата</th>
            <th>Мин</th>
            <th>Място</th>
            <th>Вода (л)</th>
            <th>Бележки</th>
            <th>Действия</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var diary in Model)
        {
            <tr>
                <td>@diary.Date.ToString("yyyy-MM-dd")</td>
                <td>@diary.DurationMinutes</td>
                <td>@diary.Place</td>
                <td>@diary.WaterLiters</td>
                <td>@diary.Notes</td>
                <td>
                    <a class="btn btn-sm btn-primary" asp-action="Edit" asp-route-id="@diary.Id">Редакция</a>
                    <a class="btn btn-sm btn-danger" asp-action="Delete" asp-route-id="@diary.Id">Изтриване</a>
                </td>
            </tr>
        }
    </tbody>
</table>