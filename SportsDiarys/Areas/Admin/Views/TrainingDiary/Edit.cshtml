@model SportsDiarys.ViewModels.TrainingDiaries.TrainingDiaryFormVm

<h1>Редакция на дневник</h1>

<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="Id" />

    <div class="mb-3">
        <label>Дата</label>
        <input asp-for="Date" type="date" class="form-control" />
    </div>
    <div class="mb-3">
        <label>Продължителност (мин)</label>
        <input asp-for="DurationMinutes" type="number" class="form-control" />
    </div>
    <div class="mb-3">
        <label>Място</label>
        <input asp-for="Place" class="form-control" />
    </div>
    <div class="mb-3">
        <label>Вода (л)</label>
        <input asp-for="WaterLiters" type="number" step="0.1" class="form-control" />
    </div>
    <div class="mb-3">
        <label>Бележки</label>
        <textarea asp-for="Notes" class="form-control"></textarea>
    </div>

    <button type="submit" class="btn btn-primary">Запази</button>
    <a asp-action="Index" class="btn btn-secondary">Отказ</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
