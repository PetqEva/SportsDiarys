@model IEnumerable<SportsDiarys.ViewModels.Admin.UserAdminVm>

@{
    ViewData["Title"] = "Потребители";
}

<h1 class="mb-4">Потребители</h1>

@if (TempData["AdminError"] != null)
{
    <div class="alert alert-danger">
        @TempData["AdminError"]
    </div>
}

@if (TempData["AdminSuccess"] != null)
{
    <div class="alert alert-success">
        @TempData["AdminSuccess"]
    </div>
}

<table class="table table-striped table-hover align-middle">
    <thead>
        <tr>
            <th>Email</th>
            <th>Потребителско име</th>
            <th>Админ</th>
            <th class="text-end">Действия</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var user in Model)
        {
            <tr>
                <td>@user.Email</td>
                <td>@user.UserName</td>
                <td>
                    @if (user.IsAdministrator)
                    {
                        <span class="badge bg-success">Да</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">Не</span>
                    }
                </td>
                <td class="text-end">
                    @if (!user.IsAdministrator)
                    {
                        <form asp-area="Admin"
                              asp-controller="Admin"
                              asp-action="Promote"
                              method="post"
                              class="d-inline">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@user.Id" />
                            <button type="submit" class="btn btn-sm btn-outline-success">
                                Направи админ
                            </button>
                        </form>
                    }
                    else
                    {
                        <form asp-area="Admin"
                              asp-controller="Admin"
                              asp-action="Demote"
                              method="post"
                              class="d-inline">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@user.Id" />
                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                Премахни админ
                            </button>
                        </form>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>

<div class="mt-3">
    <a asp-area="Admin" asp-controller="Admin" asp-action="Index" class="btn btn-outline-secondary">
        Назад
    </a>
</div>