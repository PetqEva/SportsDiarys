@model SportsDiarys.ViewModels.Exercises.ExerciseListVm

@{
    ViewData["Title"] = "Упражнения";
}

<h1 class="mb-3">@ViewData["Title"]</h1>

@if (TempData["AdminSuccess"] != null)
{
    <div class="alert alert-success">
        @TempData["AdminSuccess"]
    </div>
}

@if (TempData["AdminError"] != null)
{
    <div class="alert alert-danger">
        @TempData["AdminError"]
    </div>
}

<form method="get" class="mb-3 d-flex gap-2">
    <input type="text"
           name="Search"
           value="@Model.Query.Search"
           placeholder="Търсене..."
           class="form-control"
           style="max-width: 300px;" />

    <button type="submit" class="btn btn-primary">Търси</button>

    <a asp-action="Index" class="btn btn-outline-secondary">Изчисти</a>
</form>

<p>
    <a asp-action="Create" class="btn btn-success">+ Добави упражнение</a>
</p>

@if (!Model.Items.Any())
{
    <div class="alert alert-info">
        Няма намерени упражнения.
    </div>
}
else
{
    <table class="table table-striped align-middle">
        <thead>
            <tr>
                <th>Име</th>
                <th>Мускулна група</th>
                <th>Трудност</th>
                <th>Активно</th>
                <th class="text-end">Действия</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Items)
            {
                <tr>
                    <td>@item.Name</td>
                    <td>@item.MuscleGroup</td>
                    <td>@item.Difficulty</td>
                    <td>@(item.IsActive ? "Да" : "Не")</td>
                    <td class="text-end">
                        <a asp-action="Edit"
                               asp-route-id="@item.Id"
                               class="btn btn-sm btn-outline-primary">
                            Редакция
                        </a>

                        <form asp-action="ToggleActive"
                              method="post"
                              class="d-inline">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@item.Id" />
                            <input type="hidden" name="isActive" value="@(!item.IsActive)" />

                            <button type="submit" class="btn btn-sm btn-outline-warning">
                                @(item.IsActive ? "Деактивирай" : "Активирай")
                            </button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <nav aria-label="Навигация по страници">
        <ul class="pagination">
            <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                <a class="page-link"
                       asp-action="Index"
                       asp-route-page="@(Model.CurrentPage - 1)"
                       asp-route-search="@Model.Query.Search">
                    Назад
                </a>
            </li>

            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                    <a class="page-link"
                           asp-action="Index"
                           asp-route-page="@i"
                           asp-route-search="@Model.Query.Search">
                        @i
                    </a>
                </li>
            }

            <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                <a class="page-link"
                       asp-action="Index"
                       asp-route-page="@(Model.CurrentPage + 1)"
                       asp-route-search="@Model.Query.Search">
                    Напред
                </a>
            </li>
        </ul>
    </nav>
}