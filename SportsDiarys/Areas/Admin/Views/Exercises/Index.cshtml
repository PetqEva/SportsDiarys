@model SportsDiarys.ViewModels.Exercises.ExerciseListVm

@{
    ViewData["Title"] = "Упражнения";
}

<h1>@ViewData["Title"]</h1>

<form method="get" class="mb-3">
    <input type="text"
           name="Search"
           value="@Model.Query.Search"
           placeholder="Търсене..."
           class="form-control w-25 d-inline" />

    <button type="submit" class="btn btn-primary ms-2">Търси</button>
</form>

<p>
    <a asp-action="Create" class="btn btn-success">+ Добави упражнение</a>
</p>

@if (!Model.Items.Any())
{
    <div class="alert alert-info">
        Няма намерени упражнения.
    </div>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Име</th>
                <th>Мускулна група</th>
                <th>Трудност</th>
                <th>Активно</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Items)
            {
                <tr>
                    <td>@item.Name</td>
                    <td>@item.MuscleGroup</td>
                    <td>@item.Difficulty</td>
                    <td>@(item.IsActive ? "Да" : "Не")</td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@item.Id"
                           class="btn btn-sm btn-outline-primary">Редакция</a>

                        <form asp-action="SetActive" method="post" style="display:inline">
                            <input type="hidden" name="id" value="@item.Id" />
                            <input type="hidden" name="isActive" value="@(!item.IsActive)" />

                            <button type="submit" class="btn btn-sm btn-outline-warning">
                                @(item.IsActive ? "Деактивирай" : "Активирай")
                            </button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <nav>
        <ul class="pagination">
            <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                <a class="page-link"
                       asp-action="Index"
                       asp-route-page="@(Model.CurrentPage - 1)">
                    Назад
                </a>
            </li>

            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                    <a class="page-link"
                           asp-action="Index"
                           asp-route-page="@i">
                        @i
                    </a>
                </li>
            }

            <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                <a class="page-link"
                       asp-action="Index"
                       asp-route-page="@(Model.CurrentPage + 1)">
                    Напред
                </a>
            </li>
        </ul>
    </nav>
}